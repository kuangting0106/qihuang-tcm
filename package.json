{
  "name": "qihuang-tcm-viz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run precompute:body && npm run build:data && npm run validate:data && vite build && vue-tsc --noEmit",
    "build:data": "node scripts/build-sample-data.mjs",
    "precompute:body": "tsx scripts/precompute-body.mts",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "validate:data": "node scripts/validate-data.mjs",
    "start": "vite --open"
  },
  "dependencies": {
    "three": "^0.170.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
